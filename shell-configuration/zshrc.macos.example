# macOS ~/.zshrc example

export ZSH="${HOME}/.oh-my-zsh"
ZSH_THEME=""
PROMPT='➜  '

zstyle ':omz:update' mode auto

plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
)

if [[ -r "${ZSH}/oh-my-zsh.sh" ]]; then
    source "${ZSH}/oh-my-zsh.sh"
fi

export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"

if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="${HOME}/.local/bin:${PATH}"

Python() {
    local environment="${HOME}/venvs/PentagonToy/bin/activate"

    if [[ ! -r "${environment}" ]]; then
        print -u2 "Python environment not found: ${environment}"
        return 1
    fi

    source "${environment}"
}

if [[ -d "${HOME}/.zshrc.d" ]]; then
    for _zshrc_snippet in "${HOME}"/.zshrc.d/*.zsh(N); do
        source "${_zshrc_snippet}"
    done

    unset _zshrc_snippet
fi
